<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- CPython writes and executes generated code; the hardened runtime kills
       the process for it unless both of these are granted. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- mlx loads its Metal libraries and CPython dlopen()s extension modules at
       paths the linker never saw, which library validation rejects. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Dictation records from the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
